        "urlParameters": {
            "q": "{query}"
        },
        "responseType": "json",
        "resultSelector": "results",
        "fields": {
            "title": "title",
            "size": "size",
            "seeds": "seeders",
            "magnetUrl": "magnetLink",
            "infoHash": "infoHash",
            "source": "indexer"
        }
    },
    "notes": [
        "Aggregates AudiobookBay (Jackett) and BitMagnet",
        "Uses 24-hour Cloudflare KV Caching",
        "Filters for Category 3000 (Audio)",
