{
    "id": "audiobook-index",
    "name": "Audiobook Index",
    "version": "1.3.1",
    "providerType": "api",
    "description": "Audiobook search source",
    "search": {
        "url": "https://frosty-mud-b0e9.peanut-dash.workers.dev",
        "method": "GET",
        "headers": {
            "X-Custom-Auth": "audiobook-secure-access-2026",
            "User-Agent": "AudiobookPlayer/1.0",
            "Accept": "application/json"
        },
        "urlParameters": {
            "q": "{query}",
            "categories": "3000"
        },
        "responseType": "json",
        "resultSelector": "results",
        "fields": {
            "title": "title",
            "size": "size",
            "seeds": "seeders",
            "magnetUrl": "magnetLink",
            "infoHash": "infoHash",
            "source": "indexer"
        }
    },
    "notes": [
        "Uses Prowlarr audio category 3000 for ABB-backed searches"
    ]
}
